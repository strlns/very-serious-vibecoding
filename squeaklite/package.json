{
  "name": "squeaklite",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && vite build --mode singlefile && node scripts/singlefile.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:built": "node --test tests-built/*.test.mjs",
    "test:ui": "node --test tests-ui/*.test.mjs",
    "verify": "npm run typecheck && npm test && npm run test:ui && npm run build && npm run test:built",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts vite.config.js tsconfig.json"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "fflate": "0.8.3",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sql.js": "1.15.2"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "6.2.1",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
