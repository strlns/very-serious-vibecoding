# added for static deployments on Apache servers
# Apache-based deployments only. Requires mod_headers and AllowOverride FileInfo.
# HTML (including DirectoryIndex requests and the portable app) must revalidate.
# Only successful responses for content-hashed Vite assets are immutable.
<IfModule mod_headers.c>
    Header onsuccess unset Cache-Control
    Header always set Cache-Control "no-cache"
    <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css|wasm|woff2?|ttf|otf|png|jpe?g|gif|svg|webp|avif|ico)$">
        Header always set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_STATUS} == 200 || %{REQUEST_STATUS} == 304"
    </FilesMatch>
</IfModule>
